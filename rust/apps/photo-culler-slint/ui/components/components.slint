// Shared visual tokens and reusable controls for native and WASM screens.
// Screen components supply data and forward callbacks to the REST client.
export global DesignTokens {
    // The reference product is dark by default; light remains available to host previews.
    in-out property <bool> dark-mode: true;

    out property <color> canvas: dark-mode ? #0f1012 : #f5f6f8;
    out property <color> surface: dark-mode ? #111111 : #ffffff;
    out property <color> card-hover: dark-mode ? #1c1d21 : #f0f2f5;
    out property <color> sidebar: dark-mode ? #050505 : #f0f2f5;
    out property <color> foreground: dark-mode ? #e3e2e4 : #20242a;
    out property <color> muted: dark-mode ? #999999 : #5f6875;
    out property <color> subdued: dark-mode ? #595959 : #7b8490;
    out property <color> border: dark-mode ? #1b1b1b : #d8dde5;
    out property <color> accent: dark-mode ? #ff6b35 : #285fca;
    out property <color> focus: dark-mode ? #ff9b73 : #174ea6;
    out property <color> danger: dark-mode ? #e63946 : #a4262c;
    out property <color> best: dark-mode ? #25a18e : #127a6c;
    // The web reference uses blue Keep and orange Reject badges; desktop uses teal/red.
    out property <color> keep: dark-mode ? #58a6ff : #285fca;
    out property <color> alternate: dark-mode ? #f7c59f : #956012;
    out property <color> rejected: dark-mode ? #e63946 : #a4262c;
    out property <color> web-rejected: dark-mode ? #ff6b35 : #a4262c;
    out property <color> unrated: dark-mode ? #777777 : #727b86;
    out property <color> image-background: #050505;

    out property <string> body-font: "Inter";
    out property <string> heading-font: "Inter";
    out property <string> body-mono-font: "Menlo";
    out property <length> text-small: 10px;
    out property <length> text-body: 13px;
    out property <length> text-heading: 20px;
    out property <length> space-small: 8px;
    out property <length> space-medium: 16px;
    out property <length> space-large: 24px;
    out property <length> control-height: 36px;
}

export enum PanelState { loading, error, empty, }

// Reusable action with visible keyboard focus and the reference's compact geometry.
export component ActionButton inherits Rectangle {
    in property <string> label: "Action";
    in property <bool> enabled: true;
    in property <bool> primary: true;
    callback clicked();

    height: DesignTokens.control-height;
    min-width: 72px;
    background: primary ? DesignTokens.accent : DesignTokens.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: primary ? DesignTokens.accent : DesignTokens.border;
    opacity: enabled ? 1 : 0.45;

    focus_scope := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                accept
            } else { reject }
        }
        Rectangle {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            border-radius: 4px;
            border-width: focus_scope.has-focus ? 2px : 0px;
            border-color: DesignTokens.focus;
            background: transparent;
        }
        Text {
            text: root.label;
            color: root.primary ? #ffffff : DesignTokens.foreground;
            font-family: DesignTokens.body-font;
            font-size: DesignTokens.text-small;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            enabled: root.enabled;
            clicked => { focus_scope.focus(); root.clicked(); }
        }
    }
}

export component SidebarItem inherits Rectangle {
    in property <string> label: "Library";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback activated();

    height: 36px;
    background: selected ? DesignTokens.accent : (DesignTokens.dark-mode ? #0c0c0c : DesignTokens.sidebar);
    border-radius: 8px;

    focus_scope := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated(); accept
            } else { reject }
        }
        Rectangle {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            border-radius: 6px;
            border-width: focus_scope.has-focus ? 2px : 0px;
            border-color: DesignTokens.focus;
            background: transparent;
        }
        Text {
            x: 12px; width: parent.width - 24px; height: parent.height;
            text: root.label;
            color: root.selected ? #ffffff : (root.enabled ? DesignTokens.muted : DesignTokens.subdued);
            font-family: DesignTokens.body-font;
            font-size: DesignTokens.text-small;
            font-weight: root.selected ? 700 : 600;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea {
            enabled: root.enabled;
            clicked => { focus_scope.focus(); root.activated(); }
        }
    }
}

export component StatusPanel inherits Rectangle {
    in property <PanelState> state: PanelState.empty;
    in property <string> title: "";
    in property <string> detail: "";
    in property <string> action-label: "Retry";
    callback retry();

    min-height: 180px;
    background: DesignTokens.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: DesignTokens.border;

    VerticalLayout {
        padding: DesignTokens.space-large;
        spacing: DesignTokens.space-small;
        Text {
            text: root.title;
            color: root.state == PanelState.error ? DesignTokens.danger : DesignTokens.foreground;
            font-family: DesignTokens.heading-font;
            font-size: DesignTokens.text-heading;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.detail;
            color: DesignTokens.muted;
            font-family: DesignTokens.body-font;
            font-size: DesignTokens.text-body;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.state == PanelState.loading: Text {
            text: "CARGANDO CATÁLOGO…";
            color: DesignTokens.accent;
            font-family: DesignTokens.body-mono-font;
            font-size: DesignTokens.text-small;
            horizontal-alignment: center;
        }
        if root.state == PanelState.error: ActionButton {
            label: root.action-label;
            primary: false;
            clicked => { root.retry(); }
        }
    }
}

// Compact reusable navigation primitive. The gallery shell adds archive and operator detail.
export component Sidebar inherits Rectangle {
    in property <int> current-index: 0;
    callback navigate(index: int);

    background: DesignTokens.sidebar;
    border-width: 1px;
    border-color: DesignTokens.border;
    border-radius: 0px;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Text {
            text: "CULLER  /  01";
            color: DesignTokens.foreground;
            font-family: DesignTokens.heading-font;
            font-size: DesignTokens.text-small;
            font-weight: 900;
            height: 32px;
            vertical-alignment: center;
        }
        SidebarItem { label: "Biblioteca"; selected: root.current-index == 0; activated => { root.navigate(0); } }
        SidebarItem { label: "Sesiones"; selected: root.current-index == 1; activated => { root.navigate(1); } }
        SidebarItem { label: "Trabajos"; selected: root.current-index == 2; activated => { root.navigate(2); } }
    }
}

// Keep the original component smoke screen for component-level preview and tests.
export component ComponentCatalog inherits Window {
    title: "Photo Culler components";
    width: 720px;
    height: 480px;
    background: DesignTokens.canvas;

    HorizontalLayout {
        padding: DesignTokens.space-large;
        spacing: DesignTokens.space-large;
        Sidebar {
            width: 180px;
            current-index: 1;
            navigate(index) => { debug(index); }
        }
        VerticalLayout {
            spacing: DesignTokens.space-medium;
            Text {
                text: "Shared component catalog";
                color: DesignTokens.foreground;
                font-family: DesignTokens.heading-font;
                font-size: DesignTokens.text-heading;
                font-weight: 700;
            }
            ActionButton {
                label: DesignTokens.dark-mode ? "Use light theme" : "Use dark theme";
                clicked => { DesignTokens.dark-mode = !DesignTokens.dark-mode; }
            }
            StatusPanel {
                state: PanelState.loading;
                title: "Loading gallery";
                detail: "The catalog is being requested.";
            }
        }
    }
}
