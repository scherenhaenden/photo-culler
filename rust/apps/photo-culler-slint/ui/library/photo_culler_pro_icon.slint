// Small, dependency-free outline icons used by the Photo Culler Pro shell.
// SVG path data is compiled into Slint and rendered by both native and WASM.
export component PhotoCullerProIcon inherits Rectangle {
    in property <string> name;
    in property <color> tint: #ffffffcc;
    in property <length> size: 16px;

    width: size;
    height: size;
    background: transparent;

    function path-data() -> string {
        if root.name == "database" {
            return "M21 5 A9 3 0 0 1 3 5 A9 3 0 0 1 21 5 Z M3 5 V19 A9 3 0 0 0 21 19 V5 M3 12 A9 3 0 0 0 21 12";
        }
        if root.name == "layout-grid" {
            return "M4 3 H9 A1 1 0 0 1 10 4 V9 A1 1 0 0 1 9 10 H4 A1 1 0 0 1 3 9 V4 A1 1 0 0 1 4 3 Z M15 3 H20 A1 1 0 0 1 21 4 V9 A1 1 0 0 1 20 10 H15 A1 1 0 0 1 14 9 V4 A1 1 0 0 1 15 3 Z M4 14 H9 A1 1 0 0 1 10 15 V20 A1 1 0 0 1 9 21 H4 A1 1 0 0 1 3 20 V15 A1 1 0 0 1 4 14 Z M15 14 H20 A1 1 0 0 1 21 15 V20 A1 1 0 0 1 20 21 H15 A1 1 0 0 1 14 20 V15 A1 1 0 0 1 15 14 Z";
        }
        if root.name == "layers" {
            return "M12 2 L2 7 L12 12 L22 7 Z M2 12 L12 17 L22 12 M2 17 L12 22 L22 17";
        }
        if root.name == "zap" {
            return "M13 2 L3 14 H11 L10 22 L21 9 H13 Z";
        }
        if root.name == "calendar" {
            return "M8 3 V6 M16 3 V6 M3 10 H21 M5 4 H19 A2 2 0 0 1 21 6 V20 A2 2 0 0 1 19 22 H5 A2 2 0 0 1 3 20 V6 A2 2 0 0 1 5 4 Z";
        }
        if root.name == "activity" {
            return "M22 12 H18 L15 21 L9 3 L6 12 H2";
        }
        if root.name == "hard-drive" {
            return "M5 4 H19 A2 2 0 0 1 21 6 V18 A2 2 0 0 1 19 20 H5 A2 2 0 0 1 3 18 V6 A2 2 0 0 1 5 4 Z M3 11 H21 M7 15 H7.01 M11 15 H11.01";
        }
        if root.name == "circle-check" {
            return "M12 22 A10 10 0 1 0 12 2 A10 10 0 0 0 12 22 Z M16 10 L11 15 L8 12";
        }
        if root.name == "tag" {
            return "M20.59 13.41 L13.42 20.58 A2 2 0 0 1 10.59 20.58 L3.42 13.41 A2 2 0 0 1 2.83 12 V4 A2 2 0 0 1 4.83 2 H12 A2 2 0 0 1 13.41 2.59 L20.58 9.76 A2 2 0 0 1 20.59 13.41 Z M7 7 H7.01";
        }
        if root.name == "circle-x" {
            return "M12 22 A10 10 0 1 0 12 2 A10 10 0 0 0 12 22 Z M15 9 L9 15 M9 9 L15 15";
        }
        if root.name == "circle-help" {
            return "M12 22 A10 10 0 1 0 12 2 A10 10 0 0 0 12 22 Z M9.1 9 A3 3 0 0 1 15 10 C15 12 12 13 12 14 M12 17 H12.01";
        }
        if root.name == "search" {
            return "M20 20 L15 15 M17 10 A7 7 0 1 0 3 10 A7 7 0 0 0 17 10 Z";
        }
        if root.name == "cpu" {
            return "M9 9 H15 V15 H9 Z M9 2 V5 M15 2 V5 M9 19 V22 M15 19 V22 M2 9 H5 M2 15 H5 M19 9 H22 M19 15 H22 M7 5 H17 A2 2 0 0 1 19 7 V17 A2 2 0 0 1 17 19 H7 A2 2 0 0 1 5 17 V7 A2 2 0 0 1 7 5 Z";
        }
        if root.name == "settings" {
            return "M19.14 12.94 A7.18 7.18 0 0 0 19.14 11.06 L21.17 9.48 A0.5 0.5 0 0 0 21.29 8.84 L19.37 5.52 A0.5 0.5 0 0 0 18.76 5.3 L16.37 6.26 A7.12 7.12 0 0 0 14.74 5.32 L14.38 2.8 A0.5 0.5 0 0 0 13.89 2.4 H10.05 A0.5 0.5 0 0 0 9.56 2.8 L9.2 5.32 A7.12 7.12 0 0 0 7.57 6.26 L5.18 5.3 A0.5 0.5 0 0 0 4.57 5.52 L2.65 8.84 A0.5 0.5 0 0 0 2.77 9.48 L4.8 11.06 A7.18 7.18 0 0 0 4.8 12.94 L2.77 14.52 A0.5 0.5 0 0 0 2.65 15.16 L4.57 18.48 A0.5 0.5 0 0 0 5.18 18.7 L7.57 17.74 A7.12 7.12 0 0 0 9.2 18.68 L9.56 21.2 A0.5 0.5 0 0 0 10.05 21.6 H13.89 A0.5 0.5 0 0 0 14.38 21.2 L14.74 18.68 A7.12 7.12 0 0 0 16.37 17.74 L18.76 18.7 A0.5 0.5 0 0 0 19.37 18.48 L21.29 15.16 A0.5 0.5 0 0 0 21.17 14.52 Z M12 8 A4 4 0 1 0 12 16 A4 4 0 0 0 12 8 Z";
        }
        if root.name == "upload" {
            return "M12 16 V4 M7 9 L12 4 L17 9 M4 16 V20 H20 V16";
        }
        if root.name == "download" {
            return "M12 4 V16 M7 11 L12 16 L17 11 M4 16 V20 H20 V16";
        }
        if root.name == "filter" {
            return "M4 4 H20 L14 11 V18 L10 20 V11 Z";
        }
        if root.name == "rotate-ccw" {
            return "M3 2 V8 H9 M3.05 13 A9 9 0 1 0 5.64 5.64 L3 8";
        }
        if root.name == "star" {
            return "M12 3 L14.7 9.3 L21.5 10 L16.5 14.5 L17.8 21 L12 17.5 L6.2 21 L7.5 14.5 L2.5 10 L9.3 9.3 Z";
        }
        if root.name == "user-round" {
            return "M20 21 A8 8 0 0 0 4 21 M12 11 A4 4 0 1 0 12 3 A4 4 0 0 0 12 11 Z";
        }
        if root.name == "check" {
            return "M20 6 L9 17 L4 12";
        }
        return "";
    }

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.path-data();
        fill: #00000000;
        stroke: root.tint;
        stroke-width: root.size / 12;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}
